# Server
PORT=4310
HOST=127.0.0.1

# Set a password to require login. It is required for any non-local address.
# AUTH_PASSWORD=

# Set to true when serving over HTTPS (for example behind Caddy).
# COOKIE_SECURE=false

# Extra hostnames accepted when login is off. Comma separated.
# ALLOWED_HOSTS=

# Docker only: the host address the port is published on.
# BIND_ADDRESS=127.0.0.1

# Optional AI review (the Review page). Leave AI_PROVIDER empty to keep it off.
# Only a short summary is sent, never account names, payees or transactions.
# AI_PROVIDER=anthropic          # anthropic | bedrock | openai (Ollama, llama.cpp, any OpenAI-compatible server)
# AI_MODEL=                      # defaults to claude-sonnet-5-5 for anthropic; required for the others
# ANTHROPIC_API_KEY=
# AWS_BEARER_TOKEN_BEDROCK=      # Bedrock API key
# AWS_REGION=ap-south-1
# AI_BASE_URL=http://localhost:11434/v1   # for openai; also overrides the Anthropic and Bedrock endpoints
# AI_API_KEY=                    # if your OpenAI-compatible server wants one

# Optional alerts: a message when a bill is due, a budget is blown or the balance is heading for zero.
# Set any of these. Addresses and tokens stay here and are never shown in the app.
# NOTIFY_NTFY_URL=https://ntfy.sh/your-private-topic
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NOTIFY_WEBHOOK_URL=             # Slack, Discord, Mattermost or your own endpoint

# Optional statement folder: drop statements in and they import by themselves.
# In Docker, mount a host folder at /inbox (see docker-compose.yml) and set WATCH_DIR=/inbox.
# WATCH_DIR=
# WATCH_PASSWORDS=pass1,pass2    # tried on locked PDFs; stored only in this file

# Optional read-only login (needs AUTH_PASSWORD): can look at everything, change nothing.
# VIEWER_PASSWORD=

# Optional: encrypt backups with this passphrase (AES-256-GCM). Keep it safe: without it a backup cannot be opened.
# BACKUP_PASSPHRASE=

# Several people on one server, each with their own separate books (needs AUTH_PASSWORD).
# AUTH_PASSWORD becomes the first administrator's password, and the books already here become theirs.
# MULTI_USER=true
# ADMIN_USERNAME=admin
# AI_FOR_ALL_USERS=false         # true lets everyone use the AI key set above, otherwise only the administrator

# Optional: collect statements from a mailbox (IMAP). Use a mailbox just for statements and an app password.
# Only unread mail from MAIL_SENDERS is read, and only if the mail server confirmed the sender (set MAIL_REQUIRE_AUTH=false to skip that check).
# MAIL_HOST=imap.gmail.com
# MAIL_PORT=993
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FOLDER=INBOX
# MAIL_SENDERS=axisbank.com,scripbox.com

# Running as a site people sign up to (needs MULTI_USER=true, AUTH_PASSWORD and HTTPS):
# SIGNUP_MODE=approval           # closed (default) | invite | approval | open
# SIGNUP_RATE=6                  # sign-ups one address may make in ten minutes
# USER_QUOTA_MB=200              # space each person may use (the administrator has none)
# COOKIE_SECURE=true             # always, behind HTTPS
# TRUST_PROXY=true               # only if a reverse proxy in front sets the real address
# SECRETS_KEY=                   # openssl rand -base64 32; keeps stored keys off the data disk. Without it a key file is made in the data folder
# MAX_OPEN_LEDGERS=50            # how many people's books are kept open at once

# Sending mail (email confirmation at sign-up, forgotten passwords, an optional monthly summary).
# Use any SMTP account: Resend, Amazon SES, Mailgun, or Gmail with an app password.
# PUBLIC_URL is the address people open Ledgerly at; it goes in the links in the mail.
# PUBLIC_URL=https://money.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                  # 465 for an implicit TLS port (SMTP_SECURE=true)
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Ledgerly <no-reply@example.com>

# Copies of each new backup kept somewhere else (needs BACKUP_PASSPHRASE: backups are encrypted before they leave).
# A mounted or synced folder, in Docker mount it and give the path inside the container:
# BACKUP_COPY_DIR=/offsite
# And/or any S3-compatible bucket (Amazon S3, Backblaze B2, Cloudflare R2, MinIO):
# BACKUP_S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com
# BACKUP_S3_REGION=us-west-002
# BACKUP_S3_BUCKET=my-ledgerly-backups
# BACKUP_S3_KEY=
# BACKUP_S3_SECRET=
# BACKUP_S3_PREFIX=ledgerly
